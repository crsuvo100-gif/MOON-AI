#!/usr/bin/env bash
# MOON VS Code Launcher - Terminal integration for Hermes
# Launches VS Code (code-oss) with project-aware settings
set -euo pipefail

# Detect project root: use cwd or first argument
PROJECT_DIR="${1:-$(pwd)}"

# Resolve to absolute path
PROJECT_DIR="$(cd "$PROJECT_DIR" 2>/dev/null && pwd)" || PROJECT_DIR="$(pwd)"

# Find the VS Code executable (prefer code-oss, fallback code)
if command -v code-oss &>/dev/null; then
  CODE_EXEC="code-oss"
elif command -v code &>/dev/null; then
  CODE_EXEC="code"
else
  echo "ERROR: VS Code (code-oss) not found. Install via: sudo apt install code-oss" >&2
  exit 1
fi

# Launch VS Code with project settings
# --wait: block until VS Code closes (for scripting)
# --new-window: open in a new window (cleaner)
exec "$CODE_EXEC" \
  --new-window \
  --wait \
  --disable-gpu \
  --no-sandbox \
  "$PROJECT_DIR"
