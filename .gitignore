app/memory/episodes.json
logs/
terminal_moon/data/
terminal_moon/memory/
terminal_moon/logs/
capabilities/
connections/
data/
data/agents/
data/executions.db
plugins/generated/

# MOON runtime state
.moon/
.moon_logs/
.moon_sessions.json
.moon_terminal_history.json
.moon_workflow_logs/
.moon_workflow_complete
.ori/
.pre_commit_checkpoint/

# Local debug / runtime artifacts not intended for source control
.probe_system_info.py
app/laboratory/
home/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets (never commit credentials)
.env
.env.*
node_modules/
moon_ai_agent.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.husky/

# Tool/IDE state (local development artifacts, not part of project source)
.claude/
.claude-plugin/
.gitnexus/
.hermes/
.pytest_cache/
.vscode/

# Diagnostic / probe scripts (not part of the project)
_proof_system_info.py

