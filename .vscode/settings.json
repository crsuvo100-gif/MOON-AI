{
  "observer.exclude": [
    "node_modules",
    "**/node_modules",
    ".venv",
    "**/.venv",
    "venv",
    "**/venv",
    "__pycache__",
    "**/__pycache__",
    ".git",
    "**/.git",
    "dist",
    "**/dist",
    "build",
    "**/build",
    ".output",
    "**/.output",
    "target",
    "**/target"
  ],
  "agent_servers": {
    "hermes-agent": {
      "type": "custom",
      "command": "hermes",
      "args": [
        "acp"
      ]
    }
  },
  "workbench.editor.wrapTabs": true,
  "python.defaultInterpreterPath": ".venv/bin/python"
}
