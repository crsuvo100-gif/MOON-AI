{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run application",
      "type": "python",
      "request": "launch",
      "program": "main.py",
      "args": [
        "run"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "purpose": [
        "debug"
      ]
    },
    {
      "name": "Run tests",
      "type": "python",
      "request": "launch",
      "program": "pytest",
      "args": [
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "purpose": [
        "debug"
      ]
    }
  ],
  "compounds": [
    {
      "name": "MOON + hermes ACP",
      "configurations": [
        "MOON: Run"
      ],
      "stopAll": true
    }
  ]
}